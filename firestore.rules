rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sandboxOwner() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'kaszadavid1998@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isParticipant(data) {
      return signedIn() && data.players is list && request.auth.uid in data.players;
    }

    function validSandboxChoice(data) {
      return data.isTestModeActive != true || sandboxOwner();
    }

    function botIds() {
      return ['bot_seat_0', 'bot_seat_1', 'bot_seat_2', 'bot_seat_3'];
    }

    function existingHumanPlayers(data) {
      return data.players.removeAll(botIds());
    }

    function hasSafeInitialAuthorityState(data) {
      return data.status == 'waiting'
        && data.players.size() >= 1
        && data.players.size() <= data.maxPlayers
        && data.players.hasOnly([request.auth.uid].concat(botIds()))
        && data.diceValue == 0
        && data.hasRolled == false
        && data.winnerUid == ''
        && data.finishOrder is list
        && data.finishOrder.size() == 0
        && data.activeMove == null
        && data.activeDiceRoll == null
        && data.turnPhase == 'waitingForRoll'
        && data.turnVersion == 0
        && data.get('rerollsUsed', {}) is map
        && data.get('rerollsUsed', {}).size() == 0
        && data.get('rerollConfig', null) == null
        && data.lastActionId == ''
        && data.lastActionType == ''
        && data.aiControlledPlayers is list
        && data.aiControlledPlayers.size() == 0
        && data.pendingReconnectPlayers is list
        && data.pendingReconnectPlayers.size() == 0
        && data.forfeitedPlayers is list
        && data.forfeitedPlayers.size() == 0;
    }

    function isJoiningWaitingRoom() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && resource.data.status == 'waiting'
        && resource.data.isTestModeActive != true
        && request.resource.data.status == 'waiting'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.maxPlayers == resource.data.maxPlayers
        && request.auth.uid in request.resource.data.players
        && !(request.auth.uid in resource.data.players)
        && request.resource.data.players.size() == resource.data.players.size() + 1
        && request.resource.data.players.size() <= resource.data.maxPlayers
        && request.resource.data.players.hasAll(resource.data.players)
        && request.resource.data.playerNames.diff(resource.data.playerNames).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.preferredColors.diff(resource.data.preferredColors).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.playerDiceSkins.diff(resource.data.playerDiceSkins).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.playerSeats.diff(resource.data.playerSeats).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.pieces.diff(resource.data.pieces).affectedKeys().hasOnly([request.auth.uid])
        && changed.hasOnly([
          'players', 'playerNames', 'preferredColors', 'playerDiceSkins', 'playerSeats',
          'pieces', 'openSeats', 'matchmakingOpen', 'lastActivityAt', 'expiresAt'
        ]);
    }

    function isHostWaitingUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'waiting'
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && validSandboxChoice(request.resource.data)
        && request.resource.data.get('rerollsUsed', {}) is map
        && request.resource.data.get('rerollsUsed', {}).size() == 0
        && request.resource.data.players.hasAll(existingHumanPlayers(resource.data))
        && request.resource.data.players.hasOnly(existingHumanPlayers(resource.data).concat(botIds()))
        && changed.hasOnly([
          'players', 'playerNames', 'preferredColors', 'playerDiceSkins', 'playerSeats',
          'seatTypes', 'pieces', 'boardId', 'isTestModeActive', 'maxPlayers',
          'rerollsUsed',
          'opponentType', 'isPublic', 'openSeats', 'matchmakingOpen',
          'lastActivityAt', 'expiresAt'
        ]);
    }

    function isWaitingParticipantPreferenceUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isParticipant(resource.data)
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'waiting'
        && request.resource.data.players == resource.data.players
        && request.resource.data.preferredColors.diff(resource.data.preferredColors).affectedKeys().hasOnly([request.auth.uid])
        && changed.hasOnly(['preferredColors', 'lastActivityAt', 'expiresAt']);
    }

    function isLeavingWaitingRoom() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isParticipant(resource.data)
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'waiting'
        && request.auth.uid != resource.data.hostUid
        && !(request.auth.uid in request.resource.data.players)
        && request.resource.data.players.size() == resource.data.players.size() - 1
        && resource.data.players.hasAll(request.resource.data.players)
        && request.resource.data.playerNames.diff(resource.data.playerNames).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.preferredColors.diff(resource.data.preferredColors).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.playerDiceSkins.diff(resource.data.playerDiceSkins).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.playerSeats.diff(resource.data.playerSeats).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.pieces.diff(resource.data.pieces).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.playerPresence.diff(resource.data.playerPresence).affectedKeys().hasOnly([request.auth.uid])
        && changed.hasOnly([
          'players', 'playerNames', 'preferredColors', 'playerDiceSkins', 'playerSeats',
          'seatTypes', 'pieces', 'playerPresence', 'openSeats', 'matchmakingOpen',
          'currentTurn', 'lastActivityAt', 'expiresAt'
        ]);
    }

    function validServerTimestampFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['lastActivityAt'])
          || request.resource.data.lastActivityAt == request.time)
        && (!changed.hasAny(['expiresAt'])
          || request.resource.data.expiresAt <= request.time + duration.value(25, 'h'));
    }

    match /games/{roomId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/games/$(roomId))
          || resource.data.status == 'waiting'
          || isParticipant(resource.data));
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 20
        && resource.data.status == 'waiting'
        && resource.data.isPublic == true
        && resource.data.matchmakingOpen == true;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && isParticipant(request.resource.data)
        && validSandboxChoice(request.resource.data)
        && hasSafeInitialAuthorityState(request.resource.data)
        && request.resource.data.lastActivityAt == request.time
        && request.resource.data.createdAt == request.time;
      // Active gameplay fields can only be changed by Admin SDK code in the
      // callable backend. Clients retain narrowly scoped waiting-room writes.
      allow update: if validServerTimestampFields()
        && (isJoiningWaitingRoom()
          || isHostWaitingUpdate()
          || isWaitingParticipantPreferenceUpdate()
          || isLeavingWaitingRoom());
      allow delete: if signedIn()
        && resource.data.status == 'waiting'
        && resource.data.hostUid == request.auth.uid;
    }

    match /matchResults/{matchId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    function protectedProgressionUnchanged() {
      let protected = [
        'xp', 'coins', 'rewardedMatches', 'rewardedWins', 'rewardedPodiums',
        'progressionConfigVersion', 'lastRewardAt', 'completedAccountTransfers',
        'mergedSourceUids'
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protected);
    }

    function validNewProfileProgression() {
      return request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('rewardedMatches', 0) == 0
        && request.resource.data.get('rewardedWins', 0) == 0
        && request.resource.data.get('rewardedPodiums', 0) == 0;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validNewProfileProgression();
      allow update: if signedIn()
        && request.auth.uid == uid
        && protectedProgressionUnchanged();
      allow delete: if false;

      match /rewardClaims/{matchId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /accountMerges/{sourceUid} {
        allow read, write: if false;
      }
    }

    match /accountTransfers/{transferId} {
      allow read, write: if false;
    }

    match /appConfig/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

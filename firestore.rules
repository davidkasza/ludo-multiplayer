rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.players;
    }

    function isJoiningWaitingRoom() {
      return signedIn()
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'waiting'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.maxPlayers == resource.data.maxPlayers
        && request.auth.uid in request.resource.data.players
        && !(request.auth.uid in resource.data.players)
        && request.resource.data.players.size() == resource.data.players.size() + 1
        && request.resource.data.players.size() <= resource.data.maxPlayers
        && request.resource.data.players.hasAll(resource.data.players)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'playerNames', 'preferredColors', 'playerDiceSkins', 'playerSeats',
          'seatTypes', 'pieces', 'maxPlayers', 'opponentType', 'isPublic',
          'openSeats', 'matchmakingOpen', 'status', 'activeMove',
          'activeDiceRoll', 'lastActivityAt', 'expiresAt'
        ]);
    }

    function hasValidServerFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['lastActivityAt'])
          || request.resource.data.lastActivityAt == request.time)
        && (!changed.hasAny(['turnStartedAt'])
          || request.resource.data.turnStartedAt == null
          || request.resource.data.turnStartedAt == request.time)
        && (!changed.hasAny(['finishedAt'])
          || request.resource.data.finishedAt == null
          || request.resource.data.finishedAt == request.time)
        && (!changed.hasAny(['turnDurationSeconds'])
          || request.resource.data.turnDurationSeconds in [0, 10, 30])
        && (!changed.hasAny(['expiresAt'])
          || request.resource.data.expiresAt <= request.time + duration.value(25, 'h'))
        && (!changed.hasAny(['activeDiceRoll'])
          || request.resource.data.activeDiceRoll == null
          || request.resource.data.activeDiceRoll.stateApplied != true
          || request.resource.data.activeDiceRoll.committedAt == request.time)
        && (!changed.hasAny(['activeMove'])
          || request.resource.data.activeMove == null
          || request.resource.data.activeMove.stateApplied != true
          || request.resource.data.activeMove.committedAt == request.time);
    }

    match /games/{roomId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/games/$(roomId))
          || resource.data.status == 'waiting'
          || isParticipant(resource.data));
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 20
        && resource.data.status == 'waiting'
        && resource.data.isPublic == true
        && resource.data.matchmakingOpen == true;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && isParticipant(request.resource.data)
        && request.resource.data.status == 'waiting';
      // Gameplay remains peer-authoritative. These checks prevent outsiders
      // from mutating a room, while transaction code validates game rules.
      allow update: if hasValidServerFields()
        && (isParticipant(resource.data) || isJoiningWaitingRoom());
      allow delete: if signedIn()
        && resource.data.status == 'waiting'
        && resource.data.hostUid == request.auth.uid;
    }

    match /matchResults/{matchId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /rewardClaims/{matchId} {
        allow read, create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    match /appConfig/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

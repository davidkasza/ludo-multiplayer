{
  "name": "ludora-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint --ext .ts src test",
    "build": "tsc",
    "test": "npm run build && mocha --timeout 20000 \"lib/test/rules.test.js\" \"lib/test/auth.test.js\"",
    "test:emulator:inner": "mocha --timeout 30000 \"lib/test/firestore.rules.test.js\" \"lib/test/game_service.test.js\"",
    "test:emulator": "npm run build && firebase emulators:exec --config ../firebase.json --project demo-ludora --only firestore \"npm run test:emulator:inner\""
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "chai": "^5.3.3",
    "eslint": "^8.57.1",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2",
    "mocha": "^11.7.2",
    "typescript": "^5.9.2"
  }
}
